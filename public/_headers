/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://wa.me; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' blob: data:; connect-src 'self' https://wa.me;

# Cache (regra 9 do guia de performance). Os arquivos de /_next/static têm hash
# no nome, então podem ficar 1 ano no navegador sem risco de versão velha.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes e imagens sem hash no nome: 30 dias, revalidando em segundo plano.
/Fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/logos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/person.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/person-2.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/portfolio/*/cover.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
